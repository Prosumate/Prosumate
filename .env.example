# ==========================================
# Prosumate - self-contained internal runtime
# ==========================================

# Server
NODE_ENV=development
IS_TEST_ENVIRONMENT=true
PORT=4000
HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ALLOW_CROSS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Optional persistent PostgreSQL adapter. Leave blank to use the in-process
# repository. The current API accessor still uses the in-process repository.
DATABASE_URL=

# Internal cache, Pub/Sub, hashes, and retry queue.
# REDIS_URL is intentionally blank/ignored in internal-only mode.
REDIS_URL=

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12

# Native internal providers
EMAIL_PROVIDER=internal
INTERNAL_FROM_EMAIL=Prosumate <system@prosumate.local>
SMS_PROVIDER=internal
INTERNAL_VIRTUAL_NUMBER=+1 (555) 010-2000
PAYMENT_PROVIDER=internal
AI_PROVIDER=internal
AUTOMATION_ENGINE=internal

# Required for inbound message ingestion outside test mode.
INTERNAL_INBOUND_SECRET=replace-with-a-random-inbound-secret

# Optional legacy adapters. They are not required or used by the internal
# defaults. Supplying one of these opts into an external integration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
N8N_BASE_URL=
N8N_WEBHOOK_URL=

# Browser client. Never place private keys or secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_URL=http://localhost:4000
