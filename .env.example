# ==========================================
# Prosumate SaaS Platform - Environment Configuration
# ==========================================

# --- Environment & Server ---
NODE_ENV=development
IS_TEST_ENVIRONMENT=true
PORT=4000
HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ALLOW_CROSS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- Primary Database (Supabase PostgreSQL / Local Docker) ---
# Supabase Transaction Pooler (Port 6543, recommended for serverless/testing):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Local Docker:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/prosumate_dev

# --- Caching & Ephemeral Store (Upstash Redis / In-Memory Fallback) ---
# Optional: Leave empty to automatically fallback to zero-dependency in-memory cache
# REDIS_URL=rediss://default:[TOKEN]@[ENDPOINT].upstash.io:6379
REDIS_URL=

# --- Authentication & Session Security ---
JWT_SECRET=dev-super-secret-key-prosumate-platform-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12

# --- Email Provider (Free Test Phase: resend or mock) ---
# Set EMAIL_PROVIDER=mock for zero-cost simulated emails
# Set EMAIL_PROVIDER=resend and supply API key for free tier live delivery (up to 3,000/mo)
EMAIL_PROVIDER=mock
RESEND_API_KEY=
RESEND_FROM_EMAIL=Prosumate <onboarding@resend.dev>

# --- SMS Provider (Free Test Phase: mock or twilio) ---
# Set SMS_PROVIDER=mock for simulated SMS recorded with [SIMULATED] badge
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Billing & Payments (Free Test Phase: mock or stripe) ---
# Set PAYMENT_PROVIDER=mock for simulated checkouts and wallet top-ups with $0 charged
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI Assistant (Free Test Phase: mock or openai) ---
# Set AI_PROVIDER=mock for deterministic lead qualification and copywriting with $0 API fees
AI_PROVIDER=mock
OPENAI_API_KEY=

# --- External Automation & n8n Integration ---
# Self-hosted n8n container URL (e.g., http://localhost:5678)
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/prosumate-lead

# --- Frontend Client Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:4000
